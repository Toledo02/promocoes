# Destino do resumo. O bot precisa ser administrador do canal (ou já ter conversado com você,
# se o destino for um chat privado).
TELEGRAM_BOT_TOKEN=seu-token-do-botfather
TELEGRAM_CHAT_ID=seu-chat-id

# OPCIONAL. Só é usada quando `formatting.use_llm: true` no config.yaml — sem ela o resumo é
# montado pelo template em Python, que é o padrão. Chave gratuita em
# https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_TEMPERATURE=0.3

# Modelos tentados se o principal responder 503 (sobrecarga). Separados por vírgula.
LLM_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash

# Compatibilidade: os nomes GEMINI_* / OPENAI_* também são aceitos, para reaproveitar sem
# edição o .env que já está na VPS. Os LLM_* têm precedência.
